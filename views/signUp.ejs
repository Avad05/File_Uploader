<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - File Uploader</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#111118] text-gray-200 font-sans min-h-screen flex items-center justify-center p-6">

    <div class="w-full max-w-lg">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-600/10 rounded-2xl mb-4 border border-blue-500/20">
                <i data-lucide="user-plus" class="w-7 h-7 text-blue-500"></i>
            </div>
            <h1 class="text-3xl font-bold text-white tracking-tight">Create Account</h1>
            <p class="text-gray-500 mt-2">Join to start securing your files in the cloud</p>
        </div>

        <div class="bg-[#1e1e26] border border-gray-800/60 p-8 rounded-2xl shadow-2xl">
            <form action="/auth/sign-up" method="post" class="space-y-5">
                
                <div class="space-y-1.5">
                    <label for="name" class="text-sm font-medium text-gray-400 ml-1">Full Name</label>
                    <input type="text" id="name" name="name" required placeholder="Avadhut" 
                        class="w-full bg-[#111118] border border-gray-700 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                </div>

                <div class="space-y-1.5">
                    <div class="flex justify-between items-center ml-1">
                        <label for="username" class="text-sm font-medium text-gray-400">Username</label>
                        <span id="usernameStatus" class="text-xs font-medium"></span>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
                            <i data-lucide="at-sign" class="w-4 h-4"></i>
                        </span>
                        <input type="text" id="username" name="username" required placeholder="username" 
                            class="w-full bg-[#111118] border border-gray-700 text-white pl-10 pr-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="password" class="text-sm font-medium text-gray-400 ml-1">Password</label>
                        <input type="password" id="password" name="password" required placeholder="••••••••" 
                            class="w-full bg-[#111118] border border-gray-700 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                    </div>
                    <div class="space-y-1.5">
                        <label for="confirmPassword" class="text-sm font-medium text-gray-400 ml-1">Confirm</label>
                        <input type="password" id="confirmPassword" name="confirm" required placeholder="••••••••" 
                            class="w-full bg-[#111118] border border-gray-700 text-white px-4 py-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                    </div>
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-lg shadow-blue-900/20 mt-4 active:scale-[0.98]">
                    Create Account
                </button>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-800 text-center">
                <p class="text-gray-500 text-sm">
                    Already have an account? 
                    <a href="/auth/login" class="text-blue-400 hover:text-blue-300 font-medium transition-colors">Sign in</a>
                </p>
            </div>
        </div>
    </div>

    <script>
       lucide.createIcons();

       const usernameInput = document.getElementById('username');
       const statusSpan = document.getElementById('usernameStatus');
       let timeout = null;
   
       usernameInput.addEventListener('input', () => {
           const username = usernameInput.value;
           clearTimeout(timeout);
           
           if (username.length === 0) {
               statusSpan.textContent = "";
               usernameInput.classList.remove('border-red-500', 'border-green-500');
               return;
           }

           statusSpan.textContent = "Checking...";
           statusSpan.className = "text-xs font-medium text-gray-500";
   
           timeout = setTimeout(async () => {
               if (username.length < 3) {
                   statusSpan.textContent = "Too short";
                   statusSpan.className = "text-xs font-medium text-yellow-500";
                   return;
               }
   
               try {
                   const response = await fetch(`/auth/check-username?username=${username}`);
                   const data = await response.json();
   
                   if (data.taken) {
                       statusSpan.textContent = "Taken";
                       statusSpan.className = "text-xs font-medium text-red-500";
                       usernameInput.classList.add('border-red-500');
                       usernameInput.classList.remove('border-green-500');
                   } else {
                       statusSpan.textContent = "Available";
                       statusSpan.className = "text-xs font-medium text-green-500";
                       usernameInput.classList.add('border-green-500');
                       usernameInput.classList.remove('border-red-500');
                   }
               } catch (err) {
                   console.error("Error checking username:", err);
               }
           }, 500);
       });
    </script>
</body>
</html>