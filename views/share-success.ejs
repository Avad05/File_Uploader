<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link Generated - File Uploader</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#111118] text-gray-200 font-sans min-h-screen flex items-center justify-center p-6">

    <div class="w-full max-w-2xl">
        <div class="bg-[#1e1e26] border border-gray-800/60 p-10 rounded-3xl shadow-2xl text-center relative overflow-hidden">
            
            <div class="absolute -top-24 -left-24 w-48 h-48 bg-blue-600/10 rounded-full blur-3xl"></div>
            
            <div class="relative inline-flex items-center justify-center w-20 h-20 bg-green-500/10 rounded-2xl mb-6 border border-green-500/20">
                <i data-lucide="check-circle-2" class="w-10 h-10 text-green-500"></i>
            </div>

            <h1 class="text-3xl font-bold text-white tracking-tight mb-2">Link Generated!</h1>
            <p class="text-gray-400 mb-8 max-w-md mx-auto">
                Anyone with this link can now view the contents of 
                <span class="text-blue-400 font-medium">"<%= folderName %>"</span>.
            </p>

            <div class="space-y-3 mb-8">
                <label class="text-xs font-bold text-gray-500 uppercase tracking-widest text-left block ml-1">Public Share Link</label>
                <div class="flex items-center gap-2 p-2 bg-[#111118] border border-gray-700 rounded-xl focus-within:border-blue-500 transition-all">
                    <input 
                        type="text" 
                        value="<%= shareUrl %>" 
                        id="shareInput" 
                        readonly 
                        class="flex-1 bg-transparent border-none text-gray-300 px-3 py-2 text-sm outline-none font-mono"
                    >
                    <button 
                        onclick="copyToClipboard()" 
                        class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2 rounded-lg text-sm font-bold flex items-center gap-2 transition-all active:scale-95 shadow-lg shadow-blue-900/20"
                    >
                        <i data-lucide="copy" class="w-4 h-4"></i>
                        Copy
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-center gap-2 text-sm text-gray-500 mb-10">
                <i data-lucide="clock" class="w-4 h-4"></i>
                <p>Expires on: <span class="text-gray-400 font-medium"><%= expiresAt.toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span></p>
            </div>

            <div class="pt-8 border-t border-gray-800">
                <a href="/files/<%= user.id %>/dashboard" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 font-medium transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to Dashboard
                </a>
            </div>
        </div>

        <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-green-600 text-white px-6 py-3 rounded-full shadow-2xl opacity-0 translate-y-10 transition-all duration-300 flex items-center gap-3">
            <i data-lucide="check" class="w-5 h-5"></i>
            Link copied to clipboard!
        </div>
    </div>

    <script>
        lucide.createIcons();

        function copyToClipboard() {
            const copyText = document.getElementById("shareInput");
            copyText.select();
            navigator.clipboard.writeText(copyText.value);
            
            // Show toast instead of annoying alert
            const toast = document.getElementById('toast');
            toast.classList.remove('opacity-0', 'translate-y-10');
            toast.classList.add('opacity-100', 'translate-y-0');
            
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-10');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 3000);
        }
    </script>
</body>
</html>