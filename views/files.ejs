<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploader - Dashboard</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#111118] text-gray-200 font-sans h-screen overflow-hidden flex flex-col">

    <header class="flex items-center justify-between px-8 py-5 border-b border-gray-800/60 bg-[#111118] z-10">
        <h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            File Uploader
        </h1>
        <a href="/auth/logout" class="text-gray-400 hover:text-white transition-colors p-2 rounded-lg hover:bg-gray-800">
            <i data-lucide="log-out" class="w-6 h-6"></i>
        </a>
    </header>

    <div class="flex flex-1 overflow-hidden">
        <aside class="w-64 border-r border-gray-800/60 bg-[#111118] flex flex-col p-4 space-y-6">
            <div class="space-y-3">
                <button id="openFolderModal" class="flex items-center w-full px-4 py-2.5 text-sm font-medium border border-gray-700 rounded-lg hover:bg-gray-800 transition-all text-gray-300">
                    <i data-lucide="folder-plus" class="w-4 h-4 mr-3"></i> New Folder
                </button>
                <button id="openFileModal" class="flex items-center w-full px-4 py-2.5 text-sm font-medium border border-gray-700 rounded-lg hover:bg-gray-800 transition-all text-gray-300">
                    <i data-lucide="file-plus" class="w-4 h-4 mr-3"></i> New File
                </button>
            </div>

            <nav class="flex-1 overflow-y-auto pt-4 border-t border-gray-800/60">
                <div class="space-y-1">
                    <div class="flex items-center px-4 py-2 text-sm text-gray-300 bg-gray-800/40 border-l-2 border-blue-500 rounded-r-lg">
                        <i data-lucide="chevron-down" class="w-4 h-4 mr-2"></i>
                        <span class="truncate"><%= user.username %></span>
                    </div>
                    
                    <div class="ml-8 mt-2 space-y-2 border-l border-gray-800">
                        <% folders.forEach(folder => { %>
                            <a href="/folder/<%= folder.id %>" class="block px-4 py-1 text-sm text-gray-500 hover:text-white transition-colors truncate">
                                <%= folder.name %>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </nav>
        </aside>

        <main class="flex-1 overflow-y-auto p-10 bg-[#16161e]">
            <div class="max-w-6xl mx-auto">
                <h2 class="text-xl text-gray-400 mb-8 font-medium">
                    <%= typeof currentFolderName !== 'undefined' ? currentFolderName : "Root" %>
                </h2>

                <div class="grid grid-cols-12 px-6 py-3 text-xs font-bold text-gray-500 uppercase tracking-[0.1em]">
                    <div class="col-span-6">Name</div>
                    <div class="col-span-2">Size</div>
                    <div class="col-span-4 text-right">Created At</div>
                </div>

                <div class="mt-2 space-y-3">
                    
                    <% folders.forEach(folder => { %>
                        <div class="grid grid-cols-12 items-center px-6 py-4 bg-[#1e1e26] border border-gray-800/50 rounded-xl hover:border-gray-600 transition-all group">
                            <div class="col-span-6 flex items-center">
                                <i data-lucide="folder" class="w-5 h-5 mr-4 text-gray-400"></i>
                                <a href="/folder/<%= folder.id %>" class="text-white font-medium hover:underline"><%= folder.name %></a>
                            </div>
                            <div class="col-span-2 text-gray-500">--</div>
                            <div class="col-span-4 flex items-center justify-end space-x-4">
                                <span class="text-gray-500"><%= new Date(folder.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                                <div class="flex items-center space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button class="share-trigger-btn p-1 text-gray-400 hover:text-blue-400" data-id="<%= folder.id %>" data-name="<%= folder.name %>">
                                        <i data-lucide="share-2" class="w-4 h-4"></i>
                                    </button>
                                    <form action="/folder/delete/<%= folder.id %>" method="POST" onsubmit="return confirm('Delete this folder?')">
                                        <button type="submit" class="p-1 text-gray-400 hover:text-red-400">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>

                    <% files.forEach(file => { %>
                        <div class="grid grid-cols-12 items-center px-6 py-4 bg-[#1e1e26] border border-gray-800/50 rounded-xl hover:border-gray-600 transition-all group">
                            <div class="col-span-6 flex items-center">
                                <i data-lucide="file-text" class="w-5 h-5 mr-4 text-gray-400"></i>
                                <span class="text-white font-medium truncate"><%= file.filename %></span>
                            </div>
                            <div class="col-span-2 text-gray-500"><%= (file.size / 1024).toFixed(2) %> KB</div>
                            <div class="col-span-4 flex items-center justify-end space-x-4">
                                <span class="text-gray-500"><%= file.createdAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                                <div class="flex items-center space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <a href="/files/download/<%= file.id %>" class="p-1 text-gray-400 hover:text-green-400">
                                        <i data-lucide="download" class="w-4 h-4"></i>
                                    </a>
                                    <form action="/files/delete/<%= file.id %>" method="POST" onsubmit="return confirm('Delete this file?')">
                                        <button type="submit" class="p-1 text-gray-400 hover:text-red-400">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>

                    <% if (files.length === 0 && folders.length === 0) { %>
                        <div class="py-20 text-center">
                            <i data-lucide="inbox" class="w-12 h-12 mx-auto text-gray-700 mb-4"></i>
                            <p class="text-gray-600">No files or folders found here.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <dialog id="folderDialog" class="bg-[#1e1e26] text-white p-8 rounded-2xl border border-gray-700 backdrop:bg-black/70 w-full max-w-md outline-none">
        <form method="post" action="/folder/create-folder" class="space-y-6">
            <h3 class="text-xl font-bold">Create New Folder</h3>
            <div class="space-y-2">
                <label class="text-sm text-gray-400">Folder Name</label>
                <input type="text" name="folderName" required placeholder="e.g. University Projects" class="w-full bg-[#111118] border border-gray-700 p-3 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition-all">
            </div>
            <div class="flex justify-end gap-3 pt-4">
                <button type="button" id="closeFolderModal" class="px-5 py-2 text-gray-400 hover:text-white">Cancel</button>
                <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium transition-colors">Create</button>
            </div>
        </form>
    </dialog>

    <dialog id="fileDialog" class="bg-[#1e1e26] text-white p-8 rounded-2xl border border-gray-700 backdrop:bg-black/70 w-full max-w-md outline-none">
        <form method="post" action="/files/<%= user.id %>/dashboard" enctype="multipart/form-data" class="space-y-6">
            <h3 class="text-xl font-bold">Upload File</h3>
            <div class="space-y-4">
                <input type="file" name="fileSelect" required class="block w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-800 file:text-white hover:file:bg-gray-700">
                <input type="text" name="fileName" placeholder="Custom Filename (Optional)" class="w-full bg-[#111118] border border-gray-700 p-3 rounded-lg outline-none">
            </div>
            <div class="flex justify-end gap-3 pt-4">
                <button type="button" onclick="document.getElementById('fileDialog').close()" class="px-5 py-2 text-gray-400 hover:text-white">Cancel</button>
                <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium transition-colors">Upload</button>
            </div>
        </form>
    </dialog>

    <dialog id="shareModal" class="bg-[#1e1e26] text-white p-8 rounded-2xl border border-gray-700 backdrop:bg-black/70 w-full max-w-md outline-none">
        <form action="/files/share" method="POST" class="space-y-6">
            <h3 class="text-xl font-bold flex items-center gap-2">
                Share <span id="displayFolderName" class="text-blue-400 truncate"></span>
            </h3>
            <input type="hidden" name="folderId" id="modalFolderId">
            <div class="space-y-2">
                <label class="text-sm text-gray-400">Expiration Duration</label>
                <select name="duration" required class="w-full bg-[#111118] border border-gray-700 p-3 rounded-lg appearance-none focus:ring-2 focus:ring-blue-500">
                    <option value="1">1 Day</option>
                    <option value="7">7 Days</option>
                    <option value="10">10 Days</option>
                    <option value="30">30 Days</option>
                </select>
            </div>
            <div class="flex justify-end gap-3 pt-4">
                <button type="button" id="closeShareModal" class="px-5 py-2 text-gray-400 hover:text-white">Cancel</button>
                <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium transition-colors">Generate Link</button>
            </div>
        </form>
    </dialog>

    <script>
        // Initialize Icons
        lucide.createIcons();

        // Modal Handlers
        const folderDialog = document.getElementById('folderDialog');
        const fileDialog = document.getElementById('fileDialog');
        const shareDialog = document.getElementById('shareModal');

        document.getElementById('openFolderModal').onclick = () => folderDialog.showModal();
        document.getElementById('closeFolderModal').onclick = () => folderDialog.close();
        document.getElementById('openFileModal').onclick = () => fileDialog.showModal();

        // Share Logic
        document.querySelectorAll('.share-trigger-btn').forEach(btn => {
            btn.onclick = () => {
                document.getElementById('modalFolderId').value = btn.dataset.id;
                document.getElementById('displayFolderName').textContent = btn.dataset.name;
                shareDialog.showModal();
            }
        });
        document.getElementById('closeShareModal').onclick = () => shareDialog.close();

        // Backdrop Clicks
        [folderDialog, fileDialog, shareDialog].forEach(d => {
            d.onclick = (e) => { if(e.target === d) d.close(); };
        });
    </script>
</body>
</html>