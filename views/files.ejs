<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Files</title>
</head>
<body>
    <button id="openFolderModal">Add Folder</button>

    <dialog id="folderDialog">
  <form method="post" action="/folder/create-folder">
    <h3>Create New Folder</h3>
    <label for="folderName">Folder Name:</label>
    <input type="text" name="folderName" id="folderName" required placeholder="e.g. University Projects">
    
    <div class="modal-buttons">
      <button type="button" id="closeFolderModal">Cancel</button>
      <button type="submit">Create</button>
    </div>
  </form>
</dialog>

    <form method="post" action="/files/<%= user.id %> /dashboard" enctype="multipart/form-data">
     <label for="fileSelect">Select a file</label>
     <input type="file" name="fileSelect" id="fileSelect" required><br/>
     <label for="fileName">Enter Filename(optional)</label>
     <input type="text" name="fileName" id="fileName"><br/>
     <button type="submit">Submit</button>
    </form>
    
    <% if (files.length > 0) { %>
  <table border="2">
    <thead>
      <tr>
        <th>File Name</th>
        <th>Size (KB)</th>
        <th>Uploaded At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% files.forEach(file => { %>
        <tr>
          <td><%= file.filename %></td>
          <td><%= (file.size / 1024).toFixed(2) %> KB</td>
          <td><%= file.createdAt.toLocaleDateString() %></td>
          <td>
            <a href="/files/download/<%= file.id %>">Download</a>
            
            <form action="/files/delete/<%= file.id %>" method="POST" style="display:inline;">
              <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table><br/>
<% } else { %>
  <p>You haven't uploaded any files yet.</p>
<% } %>

    <% if (folders.length > 0) { %>
     <table border="2">
      <thead>
        <tr>
          <th>Folder Name</th>
          <th>Created-At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
       
           <% folders.forEach(element => { %>
              <tr>
                <td><a href="/folder/<%= element.id %> "><%= element.name %></a></td>
                <td><%= element.createdAt %> </td> 
                <td>
                  <button 
                    class="share-trigger-btn" 
                    data-id="<%= element.id %>" 
                    data-name="<%= element.name %>">
                    Share 🔗
                  </button
                 <form action="/folder/delete/<%= element.id %>" method="post" style="display:inline;">
                       <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
                 </form>
                </td>
              </tr> 
           <% }) %>
      </tbody>
      </table> 
  <% } else{%>
    <br/>
    <% } %> 
    <a href="/auth/logout"><button type="submit">Logout</button></a>

    <dialog id="shareModal">
        <form action="/files/share" method="POST">
        <h3>Share Folder: <span id="displayFolderName"></span></h3>
    
        <input type="hidden" name="folderId" id="modalFolderId">

        <label for="duration">Expiration Duration:</label>
       <select name="duration" id="duration" required>
         <option value="1">1 Day</option>
         <option value="7">7 Days</option>
         <option value="10">10 Days</option>
         <option value="30">30 Days</option>
       </select>

       <div style="margin-top: 20px;">
         <button type="button" id="closeShareModal">Cancel</button>
         <button type="submit">Generate Link</button>
       </div>
     </form>
    </dialog>

    <script>
        const modal = document.getElementById('folderDialog');
        const openBtn = document.getElementById('openFolderModal');
        const closeBtn = document.getElementById('closeFolderModal');
        const shareModal = document.getElementById('shareModal');
        const folderIdInput = document.getElementById('modalFolderId');
        const folderNameSpan = document.getElementById('displayFolderName');
        
        openBtn.addEventListener('click', () => {
          modal.showModal(); 
          });
        
        closeBtn.addEventListener('click', () => {
          modal.close();
        });
        
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.close();
        });

        document.querySelectorAll('.share-trigger-btn').forEach(button => {
        button.addEventListener('click', () => {
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');

        // 2. Inject the folder info into the modal
        folderIdInput.value = id;
        folderNameSpan.textContent = name;

        // 3. Open the modal
        shareModal.showModal();
    });
});

// Close logic
document.getElementById('closeShareModal').addEventListener('click', () => {
    shareModal.close();
});
      </script>
</body>
</html>