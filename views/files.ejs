<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Files</title>
</head>
<body>
    <h1>your files are displayed here</h1>
    <form method="post" action="/files/user" enctype="multipart/form-data">
     <label for="fileSelect">Select a file</label>
     <input type="file" name="fileSelect" id="fileSelect" required><br/>
     <label for="fileName">Enter Filename</label>
     <input type="text" name="fileName" id="fileName"><br/>
     <button type="submit">Submit</button>
    </form>
    <a href="/auth/logout"><button type="submit">Logout</button></a>
</body>
</html>