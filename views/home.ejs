<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploader - Secure Cloud Storage</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#111118] text-gray-200 font-sans min-h-screen flex flex-col">

    <nav class="flex items-center justify-between px-8 py-6 max-w-7xl mx-auto w-full">
        <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-900/40">
                <i data-lucide="folder-up" class="w-6 h-6 text-white"></i>
            </div>
            <span class="text-xl font-bold text-white tracking-tight">File Uploader</span>
        </div>
        <div class="space-x-4">
            <a href="/auth/login" class="text-gray-400 hover:text-white font-medium transition-colors">Login</a>
            <a href="/auth/sign-up" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-blue-900/20 active:scale-95">
                Get Started
            </a>
        </div>
    </nav>

    <main class="flex-1 flex flex-col items-center justify-center px-6 text-center max-w-4xl mx-auto py-20">
        <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight mb-6 leading-tight">
            Store and share files <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-indigo-400">
                with total confidence.
            </span>
        </h1>
        <p class="text-xl text-gray-500 mb-10 max-w-2xl leading-relaxed">
            A high-performance file management system built with Node.js and Supabase. Organize your digital life in a secure, encrypted cloud environment.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
            <a href="/auth/sign-up" class="bg-blue-600 hover:bg-blue-500 text-white px-10 py-4 rounded-2xl font-bold text-lg transition-all shadow-xl shadow-blue-900/30">
                Start Uploading Now
            </a>
            <a href="#features" class="bg-[#1e1e26] border border-gray-800 text-gray-300 px-10 py-4 rounded-2xl font-bold text-lg hover:bg-gray-800 transition-all">
                Learn More
            </a>
        </div>

        <div class="mt-20 w-full relative">
            <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-3xl blur opacity-20"></div>
            <div class="relative bg-[#1e1e26] border border-gray-800 rounded-3xl p-4 shadow-2xl">
                <img src="/images/dashboard-preview.png" alt="Dashboard Preview" class="rounded-2xl opacity-80 hover:opacity-100 transition-opacity">
            </div>
        </div>
    </main>

    <section id="features" class="bg-[#16161e] py-24 border-t border-gray-800/50">
        <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
            
            <div class="space-y-4">
                <div class="w-14 h-14 bg-blue-600/10 rounded-2xl flex items-center justify-center mx-auto border border-blue-500/20">
                    <i data-lucide="shield" class="w-8 h-8 text-blue-500"></i>
                </div>
                <h3 class="text-xl font-bold text-white">Secure Storage</h3>
                <p class="text-gray-500 leading-relaxed">Powered by Supabase Storage with industry-standard encryption and row-level security.</p>
            </div>

            <div class="space-y-4">
                <div class="w-14 h-14 bg-indigo-600/10 rounded-2xl flex items-center justify-center mx-auto border border-indigo-500/20">
                    <i data-lucide="link" class="w-8 h-8 text-indigo-500"></i>
                </div>
                <h3 class="text-xl font-bold text-white">Smart Sharing</h3>
                <p class="text-gray-500 leading-relaxed">Generate temporary signed URLs with custom expiration dates for safe public sharing.</p>
            </div>

            <div class="space-y-4">
                <div class="w-14 h-14 bg-purple-600/10 rounded-2xl flex items-center justify-center mx-auto border border-purple-500/20">
                    <i data-lucide="layout" class="w-8 h-8 text-purple-500"></i>
                </div>
                <h3 class="text-xl font-bold text-white">Intuitive UI</h3>
                <p class="text-gray-500 leading-relaxed">Navigate through nested folders and manage your files with a clean, responsive dashboard.</p>
            </div>

        </div>
    </section>

    <footer class="py-12 px-8 border-t border-gray-800 text-center text-gray-600 text-sm">
        <p>&copy; 2026 File Uploader. Developed by Avadhut on Arch Linux.</p>
    </footer>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>